# Loopback bind for the Cortex page. Not a remote host.
CORTEX_HOST=127.0.0.1
# Local page port for the Cortex page.
CORTEX_PORT=5173
# PC-side Hermes SSH host. Leave empty. Never commit a real host.
HERMES_SSH_HOST=
# PC-side Hermes SSH user. Leave empty. Never commit a real user.
HERMES_SSH_USER=
# Model API key. Leave empty. Never commit a real key.
XAI_API_KEY=
